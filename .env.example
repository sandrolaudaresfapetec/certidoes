# Banco de dados. Em desenvolvimento o app lê prisma/dev.db (src/lib/prisma.ts);
# em produção/staging é a URL do PostgreSQL (Amazon RDS), ver docs/MIGRACAO-POSTGIS.md.
DATABASE_URL="file:./prisma/dev.db"

# Backoffice (login institucional)
# Segredo do cookie de sessão (HMAC-SHA256). Obrigatório em produção.
STAFF_SESSION_SECRET="troque-este-segredo-em-producao"
# Senha inicial dos usuários criados pelo seed (/api/seed, scripts/seed*).
SEED_STAFF_PASSWORD=""

# Portal do Solicitante
# Segredo do cookie de sessão do portal (HMAC-SHA256). Obrigatório em produção.
PORTAL_SESSION_SECRET="troque-este-segredo-em-producao"
# true = login gov.br simulado (CPF + nome, homologação). Sem "true" a rota de login do portal fica desligada
# até o OIDC real (Keycloak/gov.br) existir.
GOVBR_MOCK="true"

# Integração SIGEF/INCRA (API SIGEFGEO - Conecta gov.br)
# true = usa dados simulados (padrão para desenvolvimento)
SIGEF_MOCK="true"
# Credenciais OAuth2 do Conecta gov.br (adesão do órgão)
SIGEF_CLIENT_ID=""
SIGEF_CLIENT_SECRET=""
# Endpoints (produção Conecta gov.br / SERPRO)
SIGEF_BASE_URL="https://apigateway.conectagov.estaleiro.serpro.gov.br/api-sigef-geo/v1"
SIGEF_TOKEN_URL="https://apigateway.conectagov.estaleiro.serpro.gov.br/oauth/v1"

# Sincronização diária do acervo SIGEF (scripts/sigef-scheduler.ts, processo sigef_sync no Fly)
SIGEF_SYNC_UF="SP"
SIGEF_SYNC_HORA="02:00"
SIGEF_SYNC_TZ="America/Sao_Paulo"
# SIGEF_ACERVO_URL=""        # sobrescreve a URL do zip do INCRA
# SIGEF_SYNC_LOTE="500"      # parcelas por lote
# SIGEF_SYNC_PAUSA_MS="200"  # pausa entre lotes
# SIGEF_SYNC_AO_INICIAR="true"  # executa uma vez ao subir

# Agendador da análise de duplicidade (roda dentro do app às 12:00 e 00:00 de Brasília)
# AGENDADOR_DUPLICIDADE="off"  # desliga o agendador interno
# CRON_TOKEN=""                # habilita POST /api/cron/duplicidade (Authorization: Bearer) para um agendador externo

# Widget FasterFixes (opcional; só em staging)
# NEXT_PUBLIC_FASTERFIXES_PROJECT_ID=""
# NEXT_PUBLIC_FASTERFIXES_API_ORIGIN=""
