generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String?
  role          String   // ADMIN, GERENTE, DIRETOR, TECNICO, CONFERENTE, SDTC, GDTAC, CLIENTE
  department    String?  // CATDT, CG, SDTC, GDTAC
  cpf           String?  @unique
  govBrSub      String?  @unique
  phone         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  processesResponsible  Process[]      @relation("TecnicoResponsavel")
  processesConference   Process[]      @relation("TecnicoConferencia")
  processesCreated      Process[]      @relation("CriadoPor")
  processesClient       Process[]      @relation("ClienteProcesso")
  solicitacoes          Solicitacao[]   @relation("ClienteSolicitacao")
  notifications         Notification[]
  workflowActions       WorkflowAction[]
}

model Process {
  id                String   @id @default(cuid())
  ordem             Int      @unique
  anoEntrada        Int
  tipoServico       String   // Certidao, Drenagem, Parecer, Tracado de Divisa
  expediente        String?  // SEI number
  dtAbertoSei       DateTime?
  dtCompile         DateTime?
  
  // Client Info
  tipo              String   // Comum-CPF, Comum-CNPJ, Orgao-Publico, Justica, idoso
  interessado       String
  email             String?
  telefone          String?
  cpfCnpj           String?
  
  // Elderly priority
  dtNascimentoIdoso DateTime?
  idadeTrava        Float?
  
  // Location
  pasta             String?
  utm               String?
  municipio         String?
  ra                String?  // Regiao Administrativa
  dra               String?
  divisaDificuldade String?
  
  // SIGEF Integration
  codigoSigef       String?
  areaSigef         Float?
  statusSigef       String?
  nomeFazenda       String?
  matriculaSigef    String?
  detentorSigef     String?
  municipioSigef    String?
  ufSigef           String?
  representanteTecnico String?
  dataRegistroSigef DateTime?
  poligonoSigef     Json?
  
  // Document Validation (SDTC checklist)
  docRequerimento   Boolean  @default(false)
  docIdentidade     Boolean  @default(false)
  docProcuracao     Boolean  @default(false)
  docComprovante    Boolean  @default(false)
  docPlanta         Boolean  @default(false)
  docMatricula      Boolean  @default(false)
  docArt            Boolean  @default(false)
  docsValidados     Boolean  @default(false)
  obsDocumentos     String?
  
  // Internal process number (generated after doc validation)
  numeroProcessoInterno String?
  
  // Workflow Status
  situacao          String   @default("entrada_sdtc") // entrance stage
  nivelPrioridade   String?
  statusEscritorio  String?
  observacaoEntrada String?
  diasTranscorridos Int      @default(0)
  
  // Technical Assignment
  tecnicoRespId     String?
  tecnicoResp       User?    @relation("TecnicoResponsavel", fields: [tecnicoRespId], references: [id])
  quemVaiAssinar    String?
  dtEmail           DateTime?
  dtVisita1         DateTime?
  observacoesTecnico String?
  
  // Conference
  tecnicoConfId     String?
  tecnicoConf       User?    @relation("TecnicoConferencia", fields: [tecnicoConfId], references: [id])
  observacoesConferencia String?
  dtConf            DateTime?
  
  // Output
  numeroSaidaIGC    String?
  stGabineteP1      Float?   @default(0)
  stGabineteP2      Float?   @default(0)
  stCampo           Float?   @default(0)
  
  // Signatures
  dtAssTecnico      DateTime?
  dtAssGerente      DateTime?
  dtAssDiretor      DateTime?
  dtUpadoSei        DateTime?
  
  // Suspension
  dtInicioSobrestado DateTime?
  dtFimSobrestado    DateTime?
  
  // Cancellation
  dtCancelado       DateTime?
  motivoCancelamento String?
  
  // Financial
  taxaAbertura      Float?   @default(0)
  servicoTecGabinete Float?  @default(0)
  taxaVistoria      Float?   @default(0)
  servicoTecCampo   Float?   @default(0)
  total             Float?   @default(0)
  
  // Base map reference
  base              String?  // 10k, 50k, MDT 2023, Ortomosaico 2010
  departamento      String?  // CATDT, CG
  
  // Client relation
  clienteId         String?
  cliente           User?    @relation("ClienteProcesso", fields: [clienteId], references: [id])
  
  // Metadata
  criadoPorId       String?
  criadoPor         User?    @relation("CriadoPor", fields: [criadoPorId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  solicitacao       Solicitacao?
  notifications     Notification[]
  workflowActions   WorkflowAction[]
}

model Solicitacao {
  id                String   @id @default(cuid())

  // Status: pendente, em_analise, aprovada, devolvida, rejeitada
  status            String   @default("pendente")

  // Service type requested
  tipoServico       String

  // Client data
  interessado       String
  email             String?
  telefone          String?
  cpfCnpj           String?
  tipo              String   // Comum-CPF, Comum-CNPJ, Orgao-Publico, Justica, idoso
  dtNascimentoIdoso DateTime?

  // Location
  municipio         String?
  ra                String?

  // SIGEF data
  codigoSigef       String?
  areaSigef         Float?
  statusSigef       String?
  nomeFazenda       String?
  matriculaSigef    String?
  detentorSigef     String?
  municipioSigef    String?
  ufSigef           String?
  representanteTecnico String?

  // Document checklist (client uploads)
  docRequerimento   Boolean  @default(false)
  docIdentidade     Boolean  @default(false)
  docProcuracao     Boolean  @default(false)
  docComprovante    Boolean  @default(false)
  docPlanta         Boolean  @default(false)
  docMatricula      Boolean  @default(false)
  docArt            Boolean  @default(false)
  arquivoGeo        String?  // georeferenced file name/path

  // SDTC review notes
  observacaoSDTC    String?

  // Relations
  clienteId         String
  cliente           User     @relation("ClienteSolicitacao", fields: [clienteId], references: [id])

  // Converted process reference
  processId         String?  @unique
  process           Process? @relation(fields: [processId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  type        String   // NOVA_ENTRADA, ATRIBUICAO, AGUARDANDO_CLIENTE, ANALISE_COMPLETA, CONFERENCIA_COMPLETA, ASSINATURA_PENDENTE, PROCESSO_CONCLUIDO, PRAZO_VENCIDO
  title       String
  message     String
  read        Boolean  @default(false)
  whatsappSent Boolean @default(false)
  
  processId   String?
  process     Process? @relation(fields: [processId], references: [id])
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
}

model WorkflowAction {
  id          String   @id @default(cuid())
  processId   String
  process     Process  @relation(fields: [processId], references: [id])
  
  fromStatus  String
  toStatus    String
  action      String   // Description of action taken
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
}
