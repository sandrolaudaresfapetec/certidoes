diff --git a/apps/web/src/lib/mailer/console.ts b/apps/web/src/lib/mailer/console.ts
new file mode 100644
index 0000000..d74086b
--- /dev/null
+++ b/apps/web/src/lib/mailer/console.ts
@@ -0,0 +1,63 @@
+import "server-only";
+
+import {
+  Contact,
+  CreateContactOptions,
+  EmailError,
+  EmailResponse,
+  Mailer,
+  MailOptions,
+  UpdateContactOptions,
+} from "./types";
+
+// Self-hosted installs without a transactional email provider: emails are
+// written to the server log so verification / reset links stay reachable.
+// Contacts (marketing segments) have no meaning here and are no-ops.
+export class ConsoleMailer implements Mailer {
+  emails = {
+    send: async (options: MailOptions): Promise<EmailResponse> => {
+      const links = Array.from(
+        (options.body ?? "").matchAll(/https?:\/\/[^\s"'<>]+/g),
+        (match) => match[0],
+      );
+      console.info(
+        `[mailer:console] to=${options.to} subject="${options.subject}"` +
+          (links.length ? `\n  ${links.join("\n  ")}` : ""),
+      );
+      return { success: true, message: "Logged to console" };
+    },
+  };
+
+  contacts = {
+    list: async (): Promise<Contact[]> => [],
+    create: async (options: CreateContactOptions): Promise<Contact> => {
+      const now = new Date().toISOString();
+      return {
+        id: options.email,
+        email: options.email,
+        subscribed: options.subscribed,
+        data: options.data ?? {},
+        createdAt: now,
+        updatedAt: now,
+      };
+    },
+    get: async (): Promise<Contact> => {
+      throw new EmailError("Contacts are not available with the console mailer");
+    },
+    update: async (options: UpdateContactOptions): Promise<Contact> => {
+      const now = new Date().toISOString();
+      return {
+        id: options.id ?? options.email ?? "",
+        email: options.email ?? "",
+        subscribed: options.subscribed ?? false,
+        data: options.data ?? {},
+        createdAt: now,
+        updatedAt: now,
+      };
+    },
+    delete: async (): Promise<Contact> => {
+      throw new EmailError("Contacts are not available with the console mailer");
+    },
+    addToSegment: async (): Promise<void> => {},
+  };
+}
diff --git a/apps/web/src/lib/mailer/mailer-factory.ts b/apps/web/src/lib/mailer/mailer-factory.ts
index 412652b..b2bda54 100644
--- a/apps/web/src/lib/mailer/mailer-factory.ts
+++ b/apps/web/src/lib/mailer/mailer-factory.ts
@@ -1,20 +1,54 @@
 import "server-only";
 
+import { ConsoleMailer } from "./console";
 import { PlunkMailer } from "./plunk";
 import { ResendMailer } from "./resend";
 import { Mailer } from "./types";
 
-type MailerProvider = "plunk" | "resend";
+type MailerProvider = "plunk" | "resend" | "console";
 
-export function createMailer(): Mailer {
-  const provider = "resend" as MailerProvider;
+function resolveProvider(): MailerProvider {
+  const configured = process.env.MAILER_PROVIDER;
+  if (configured === "plunk" || configured === "resend" || configured === "console") {
+    return configured;
+  }
+  // "console" is never inferred: it prints auth links to the logs, so it has to be an explicit choice.
+  return process.env.PLUNK_SECRET_KEY && !process.env.RESEND_API_KEY ? "plunk" : "resend";
+}
+
+function instantiate(): Mailer {
+  const provider = resolveProvider();
 
   switch (provider) {
     case "plunk":
       return new PlunkMailer(process.env.PLUNK_SECRET_KEY!);
     case "resend":
       return new ResendMailer(process.env.RESEND_API_KEY!);
+    case "console":
+      return new ConsoleMailer();
     default:
       throw new Error(`Unsupported mailer provider: ${provider}`);
   }
 }
+
+// Provider SDKs throw when constructed without an API key. Deferring construction
+// until the first send keeps the app bootable (and `next build` runnable) on
+// self-hosted installs that have not configured email yet.
+export function createMailer(): Mailer {
+  let instance: Mailer | undefined;
+  const get = () => (instance ??= instantiate());
+
+  return {
+    emails: {
+      send: (options) => get().emails.send(options),
+    },
+    contacts: {
+      list: () => get().contacts.list(),
+      create: (options) => get().contacts.create(options),
+      get: (id) => get().contacts.get(id),
+      update: (options) => get().contacts.update(options),
+      delete: (id) => get().contacts.delete(id),
+      addToSegment: (options) => get().contacts.addToSegment(options),
+    },
+  };
+}
