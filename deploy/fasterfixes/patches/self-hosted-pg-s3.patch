diff --git a/apps/web/src/server/inngest/attach-screenshot-to-github-issue.ts b/apps/web/src/server/inngest/attach-screenshot-to-github-issue.ts
new file mode 100644
index 0000000..047442d
--- /dev/null
+++ b/apps/web/src/server/inngest/attach-screenshot-to-github-issue.ts
@@ -0,0 +1,102 @@
+import { getInstallationOctokit } from "@/server/github/github-app";
+import { getSignedAssetUrl } from "@/server/storage/get-signed-asset-url";
+import { resolveS3Url } from "@/server/storage/resolve-s3-url";
+import { prisma } from "@workspace/db";
+import { inngest } from "./index";
+
+// `create-github-issue` waits a bounded time for the screenshot; anything that
+// lands after that window reaches the issue through this handler instead.
+// The wait below covers the race where the screenshot is attached while the
+// issue is still being created (no issue link yet).
+const ISSUE_CREATION_GRACE_PERIOD = "2m";
+
+const SCREENSHOT_MARKER = "![Screenshot](";
+
+async function loadFeedback(feedbackId: string) {
+  return prisma.feedback.findUnique({
+    where: { id: feedbackId },
+    select: {
+      screenshot: { select: { key: true, bucket: true } },
+      issueLink: {
+        select: {
+          id: true,
+          issueNumber: true,
+          projectGitHubLink: {
+            select: {
+              repoOwner: true,
+              repoName: true,
+              gitHubInstallation: { select: { installationId: true } },
+            },
+          },
+        },
+      },
+    },
+  });
+}
+
+export const attachScreenshotToGitHubIssue = inngest.createFunction(
+  {
+    id: "attach-screenshot-to-github-issue",
+    retries: 3,
+    concurrency: { key: "event.data.feedbackId", limit: 1 },
+    triggers: [{ event: "feedback/screenshot-attached" }],
+  },
+  async ({ event, step }) => {
+    const { feedbackId } = event.data;
+
+    let feedback = await step.run("load-feedback", () =>
+      loadFeedback(feedbackId),
+    );
+    if (!feedback) return { skipped: "feedback_not_found" };
+    if (!feedback.screenshot) return { skipped: "no_screenshot" };
+
+    if (!feedback.issueLink) {
+      await step.sleep("wait-for-issue", ISSUE_CREATION_GRACE_PERIOD);
+      feedback = await step.run("reload-feedback", () =>
+        loadFeedback(feedbackId),
+      );
+      if (!feedback?.screenshot) return { skipped: "no_screenshot" };
+      if (!feedback.issueLink) return { skipped: "no_github_issue" };
+    }
+
+    const { issueLink, screenshot } = feedback;
+    const { repoOwner, repoName, gitHubInstallation } =
+      issueLink.projectGitHubLink;
+
+    return step.run("update-issue-body", async () => {
+      const octokit = getInstallationOctokit(gitHubInstallation.installationId);
+      const current = await octokit.request(
+        "GET /repos/{owner}/{repo}/issues/{issue_number}",
+        { owner: repoOwner, repo: repoName, issue_number: issueLink.issueNumber },
+      );
+      const body = (current.data as { body: string | null }).body ?? "";
+
+      // Idempotent: a second delivery (or the create path having already
+      // embedded the image) must not add a second screenshot.
+      if (body.includes(SCREENSHOT_MARKER)) {
+        return { skipped: "screenshot_already_present" };
+      }
+
+      const screenshotUrl = process.env.NEXT_PUBLIC_STORAGE_BASE_URL
+        ? resolveS3Url(screenshot.key)
+        : await getSignedAssetUrl(screenshot, 3600);
+
+      await octokit.request(
+        "PATCH /repos/{owner}/{repo}/issues/{issue_number}",
+        {
+          owner: repoOwner,
+          repo: repoName,
+          issue_number: issueLink.issueNumber,
+          body: `${body}\n\n${SCREENSHOT_MARKER}${screenshotUrl})`,
+        },
+      );
+
+      await prisma.feedbackIssueLink.update({
+        where: { id: issueLink.id },
+        data: { lastSyncSource: "app", lastSyncAt: new Date() },
+      });
+
+      return { issueNumber: issueLink.issueNumber, screenshotUrl };
+    });
+  },
+);
