+// Read lazily so routes that merely import this module (Inngest handler, tRPC)
+// still load on installs where the GitHub App is not configured yet.
+function getAppCredentials() {
+  const appId = process.env.GITHUB_APP_ID;
+  const privateKey = process.env.GITHUB_PRIVATE_KEY;
+  if (!appId || !privateKey) {
+    throw new Error("GITHUB_APP_ID and GITHUB_PRIVATE_KEY must be set to use the GitHub integration");
+  }
+  return { appId, privateKey: privateKey.replace(/\\n/g, "\n") };
+}
 
